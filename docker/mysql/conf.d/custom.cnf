# /docker/mysql/conf.d/custom.cnf
#
# Two profiles:
# 1) PROD_BIG (ACTIVE): 8 vCPU / 16 GB RAM (app + mysql on same machine)
# 2) PROD_TINY (COMMENTED): 1 vCPU / 1 GB RAM (VERY constrained)
#
# To switch to PROD_TINY:
# - comment PROD_BIG lines
# - uncomment PROD_TINY lines
# - recreate mysql container: docker compose up -d --force-recreate mysql_bds

[mysqld]

# =========================
# PROD_BIG (8 vCPU / 16 GB) - ACTIVE
# =========================
innodb_buffer_pool_size = 7G
innodb_buffer_pool_instances = 4
innodb_flush_method = O_DIRECT
innodb_redo_log_capacity = 1024M
max_connections = 200
skip_name_resolve = 1

# =========================
# PROD_TINY (1 vCPU / 1 GB) - FALLBACK (uncomment if you downgrade)
# =========================
# innodb_buffer_pool_size = 256M
# innodb_buffer_pool_instances = 1
# innodb_flush_method = O_DIRECT
# innodb_redo_log_capacity = 128M
# max_connections = 50
# skip_name_resolve = 1
#
# Optional extra clamps for tiny boxes (only if you see OOM / swapping):
# table_open_cache = 200
# tmp_table_size = 32M
# max_heap_table_size = 32M
